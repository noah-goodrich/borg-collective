#!/usr/bin/env python3
"""link-parity-harness — differential oracle for the `borg link` zsh->Python port.

THE `render` LEG IS RETIRED (AC2/S4, 2026-08-27). EVIDENCE REPLACED, NOT EVIDENCE DROPPED.
-------------------------------------------------------------------------------------------
This script used to run all four human `borg link` modes through BOTH the current tree and the LAST
zsh implementation (extracted from `ad99612`, the tree immediately before the Phase 3 render flip)
and classify every difference. That differential is now **unreproducible by construction**: AC2/S3
deleted `render.overview` and `render.deep` and replaced all three human renderers with a single
`render.document()` over a fixed seven-section spine. The oracle at `ad99612` renders the OLD
document. Comparing the two would not measure port fidelity; it would print the AC2 redesign back as
one enormous unexplained diff, every line of it intended.

What the render leg proved -- that a human `borg link` render does not drift silently -- is now
proved by artifacts that CAN be regenerated on demand, which the zsh oracle never could:

  - `tests/fixtures/link/link-overview.golden`, `link-overview-all.golden`, `link-deep.golden`
    and `link-porcelain.golden`, asserted by `_assert_link_golden` in tests/cli_contract.bats.
  - `link-grid-repository.golden` / `link-grid-orchestrator.golden` via `_assert_link_grid_golden`,
    which pin the topological picture in both scopes.
  - `picture-fork.expected` / `picture-crossing.expected` -- hand-authored, never regenerated, so
    the picture has an oracle that does NOT come from the implementation it checks.

`ad99612` is not rewritten and is still reachable in history; nothing here stops a future reader from
extracting that tree by hand. What is gone is the CLAIM that a byte-comparison against it means
anything after S3.

WHAT THIS SCRIPT STILL DOES
----------------------------
The `primitives` leg: differentials of the individual ported primitives against the exact shell
one-liners they replace -- `core.heading_title`, `core.ship_date`, `core.plan_progress`,
`core.plan_objective` -- over the real markdown reachable from the registry (PROJECT_PLAN.md and
`docs/plans/assimilated/*.md` for every registered project). These primitives were ported from shell
and their shell originals still exist verbatim in this file, so the comparison remains live and
reproducible. `render._fold_s` vs `fold -s` is already covered by `test_matches_real_fold_s_binary`
in borg_core/link/test_render.py -- NOT duplicated here.

THE ONE DEVIATION THAT STILL FIRES
-----------------------------------
`grep -c '^- [x]' ... || echo 0` captures BOTH grep's own printed "0" (grep exits 1 but still prints
a count) and the `|| echo 0` fallback, so the shell value becomes the two-line string "0\\n0"
whenever nothing is checked off. `core.plan_progress` is the deliberate fix and returns a plain int.
Flagged EXPECTED iff the shell side is exactly that two-line shape and Python's value is its second
line -- narrow on purpose, so a real regression cannot hide behind it.

(Two further deviations -- the `(NOm)` assimilated ordering and the empty-`Shipped:` IFS-tab field
shift -- were RENDER-level only. They are recorded in
docs/plans/assimilated/2026-08-12-port-borg-link-to-the-python-core.md and retired with the leg that
observed them.)

READ-ONLY, ALWAYS
------------------
The primitives leg reads the real registry and the real plan files and writes to NEITHER. It runs no
`borg` subcommand at all -- no `borg.zsh` invocation, no sandbox, no adapter, no `gh`, so it is
hermetic with respect to the network without needing to be neutralized. `BORG_UPDATE_GOLDEN` is READ
NOWHERE in this script; it is not a golden-file tool.

USAGE
-----
    bin/link-parity-harness                    # the primitive differentials (the only leg left)
    bin/link-parity-harness primitives          # same, named explicitly
    bin/link-parity-harness --registry PATH     # use a fixture registry instead of the real one
    bin/link-parity-harness render              # RETIRED -- exits 2 with the reason
    bin/link-parity-harness --help

Exit code 0: every primitive differential matched or is the known deviation above.
Exit code 1: at least one UNEXPECTED mismatch was found (see stdout).
Exit code 2: setup failure (missing registry), or the retired `render` leg was requested.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

RENDER_RETIRED_LEAD = (
    "the 'render' leg was retired in AC2/S4 — its oracle is the pre-AC2 zsh renderer at ad99612, "
    "and S3 replaced all three human renderers with render.document(), so the comparison is "
    "unreproducible by construction."
)
RENDER_RETIRED_POINTER = (
    "The evidence it carried now lives in the regenerable goldens: link-overview[-all].golden, "
    "link-deep.golden, link-porcelain.golden (_assert_link_golden) and link-grid-*.golden "
    "(_assert_link_grid_golden) in tests/cli_contract.bats. Run: bats tests/cli_contract.bats"
)


def _run(cmd: list[str]) -> subprocess.CompletedProcess:
    """Every subprocess this script forks. `**kwargs` (cwd/env) went with the render leg's sandbox --
    the primitives leg runs `bash -c` one-liners and `python3 -c` in the ambient environment."""
    return subprocess.run(cmd, capture_output=True, text=True, check=False)


# --------------------------------------------------------------------------------------------- #
# Primitive-level differentials
# --------------------------------------------------------------------------------------------- #

def _shell_heading_title(path: Path) -> str:
    proc = _run(["bash", "-c", "head -1 \"$1\" | sed 's/^#* *//'", "_", str(path)])
    return proc.stdout.rstrip("\n")


def _shell_ship_date(path: Path) -> str:
    proc = _run(["bash", "-c",
                 "grep -m1 'Shipped:' \"$1\" | sed 's/.*Shipped: *//' | sed 's/ .*//'", "_", str(path)])
    return proc.stdout.rstrip("\n")


def _shell_plan_progress(path: Path) -> tuple[str, str]:
    total = _run(["bash", "-c", "grep -c '^\\- \\[' \"$1\" 2>/dev/null || echo 0", "_", str(path)])
    done = _run(["bash", "-c", "grep -c '^\\- \\[x\\]' \"$1\" 2>/dev/null || echo 0", "_", str(path)])
    return done.stdout.strip(), total.stdout.strip()


def _shell_plan_objective(path: Path) -> str:
    proc = _run(["bash", "-c",
                 "grep -A2 '^## Objective' \"$1\" | grep -v '^## Objective' | grep -v '^$' | head -1",
                 "_", str(path)])
    return proc.stdout.rstrip("\n")


def _py_core(repo_root: Path, func: str, *args: str) -> str:
    code = (
        "import sys, json; sys.path.insert(0, sys.argv[1]); "
        "from borg_core.link import core; "
        f"print(json.dumps(core.{func}(*sys.argv[2:])))"
    )
    proc = _run([sys.executable, "-c", code, str(repo_root), *args])
    if proc.returncode != 0:
        raise RuntimeError(f"core.{func}({args!r}) failed: {proc.stderr.strip()}")
    return json.loads(proc.stdout)


def _collect_sample_files(registry_path: Path, limit: int = 40) -> dict:
    """Real markdown files reachable from the registry: PROJECT_PLAN.md and assimilated plans.
    Read-only -- never written to. Bounded to `limit` per category so this stays fast."""
    registry = json.loads(registry_path.read_text())
    plans: list[Path] = []
    assimilated: list[Path] = []
    for entry in (registry.get("projects") or {}).values():
        path = entry.get("path")
        if not path or path == "null":
            continue
        base = Path(path)
        plan = base / "PROJECT_PLAN.md"
        if plan.is_file():
            plans.append(plan)
        assim_dir = base / "docs" / "plans" / "assimilated"
        if assim_dir.is_dir():
            assimilated.extend(sorted(assim_dir.glob("*.md")))
    return {"plans": plans[:limit], "assimilated": assimilated[:limit]}


def cmd_primitives(repo_root: Path, registry_path: Path) -> int:
    samples = _collect_sample_files(registry_path)
    cases = []

    for path in samples["plans"]:
        text = path.read_text(errors="replace")
        py_title = _py_core(repo_root, "heading_title", text)
        sh_title = _shell_heading_title(path)
        cases.append(("heading_title", str(path), py_title, sh_title))

        py_met, py_total = _py_core(repo_root, "plan_progress", text)
        sh_met, sh_total = _shell_plan_progress(path)
        # The one surviving deviation: `grep -c ... || echo 0` prints the two-line "0\n0" artifact
        # (see the module docstring) whenever nothing is checked off; core.plan_progress is the
        # deliberate fix, returning a plain int. Expected iff shell's raw output is that two-line
        # "0\n0" shape and Python's int is its second line.
        progress_deviation = sh_met == "0\n0" and str(py_met) == "0"
        cases.append(("plan_progress", str(path), f"{py_met}/{py_total}", f"{sh_met}/{sh_total}",
                      progress_deviation))

        py_obj = _py_core(repo_root, "plan_objective", text)
        sh_obj = _shell_plan_objective(path)
        expected_deviation = sh_obj == "--" and py_obj == ""
        cases.append(("plan_objective", str(path), py_obj, sh_obj, expected_deviation))

    for path in samples["assimilated"]:
        text = path.read_text(errors="replace")
        py_title = _py_core(repo_root, "heading_title", text)
        sh_title = _shell_heading_title(path)
        cases.append(("heading_title", str(path), py_title, sh_title))

        py_ship = _py_core(repo_root, "ship_date", text)
        sh_ship = _shell_ship_date(path)
        expected_deviation = py_ship.startswith("(**") or sh_ship.startswith("(**")
        cases.append(("ship_date", str(path), py_ship, sh_ship, expected_deviation))

    print(f"link-parity-harness: primitive differential -- {len(cases)} cases across "
          f"{len(samples['plans'])} plans + {len(samples['assimilated'])} assimilated files")
    print("  (render._fold_s vs `fold -s` is already covered by "
          "borg_core/link/test_render.py::TestFoldS::test_matches_real_fold_s_binary -- not duplicated here)")
    print()

    mismatches = 0
    for case in cases:
        prim, path, py_val, sh_val = case[0], case[1], case[2], case[3]
        known = case[4] if len(case) > 4 else False
        if py_val == sh_val:
            continue
        if known:
            print(f"  [EXPECTED] {prim} {path}: python={py_val!r} shell={sh_val!r} "
                  "(known deviation, see script header)")
            continue
        mismatches += 1
        print(f"  [UNEXPECTED] {prim} {path}: python={py_val!r} shell={sh_val!r}")

    print()
    if mismatches:
        print(f"link-parity-harness: FAIL -- {mismatches} unexpected primitive mismatch(es).", file=sys.stderr)
        return 1
    print("link-parity-harness: PASS -- every primitive differential matched or is a known deviation.")
    return 0


# --------------------------------------------------------------------------------------------- #
# Entry point
# --------------------------------------------------------------------------------------------- #

def _default_registry_path() -> Path:
    xdg = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(xdg) / "borg" / "registry.json"


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="link-parity-harness",
        description="Primitive-level differential for the borg link zsh->Python port. The whole-"
        "command 'render' differential is RETIRED -- see the module docstring (top of this file).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("mode", nargs="?", choices=["render", "primitives", "all"], default="all",
                        help="'primitives' (default, and 'all' is its synonym); 'render' is RETIRED "
                             "and exits 2 with the reason")
    parser.add_argument("--registry", type=Path, default=None,
                        help="registry.json to use (default: the real registry at "
                        "$XDG_CONFIG_HOME/borg/registry.json / ~/.config/borg/registry.json, "
                        "READ-ONLY -- this script never writes to it)")
    args = parser.parse_args(argv)

    # THE RETIREMENT GATE LIVES HERE, in the artifact that implements the command, not in a caller --
    # the same altitude the `borg recon` retirement settled on (borg_core/recon/cli.py::main, filed in
    # docs/plans/assimilated/2026-08-26-recon-retirement-gate-altitude.md). `render` stays a
    # RECOGNIZED token rather than being dropped from `choices` so that asking for it gets the reason
    # the evidence moved, not argparse's "invalid choice". A stale byte-copy of this file may still
    # ship a working render leg at ~/.claude/bin/link-parity-harness until `borg setup` next runs;
    # that copy will lie, and this message is what the repo copy says instead.
    if args.mode == "render":
        print(f"link-parity-harness: STOP -- {RENDER_RETIRED_LEAD}", file=sys.stderr)
        print(f"link-parity-harness: {RENDER_RETIRED_POINTER}", file=sys.stderr)
        return 2

    repo_root = Path(__file__).resolve().parent.parent
    registry_path = args.registry or _default_registry_path()
    if not registry_path.is_file():
        print(f"link-parity-harness: STOP -- no registry at {registry_path}", file=sys.stderr)
        return 2

    return cmd_primitives(repo_root, registry_path)


if __name__ == "__main__":
    sys.exit(main())
