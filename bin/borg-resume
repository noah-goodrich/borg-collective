#!/usr/bin/env bash
# borg-resume -- durable interruption ledger for Claude sessions (S1 ledger, S7 watcher, S7b ack and defer).
#
# Verbs:
#   record <event>   called by a hook with the hook payload on stdin. Appends ONE fact to
#                    events/<sid>.jsonl; for session_start it also writes the registry
#                    sessions/<sid>.json (replaced atomically on each session_start) and binds the tmux pane (@borg_sid).
#                    Exits 0 silently on every failure once its lib loads; exits 3 with one stderr line when it can not
#                    load resume-paths.sh (S12). Never blocks: it is called from a hook.
#   pause            create the DISABLED sentinel (nothing will inject; recording continues)
#   unpause          remove it
#   probe            print the session usage percent (own claude -p /usage sample, cached 120s)
#   watch --once     one watcher pass: fold, scan (S7), then pre-flight gate + confirmation (S9)
#   inventory <sid>  print the in-flight inventory as JSON (slice S5; --json is accepted, JSON is the only format)
#   prompt <rid>     render prompts/<rid>.md, or with --line / --compact-line the injection strings (slice S6)
#   mark-closed <project|sid>  append a deliberate-close event (like SessionEnd prompt_input_exit); slice S3b
#   ack <rid>        append an ack event for a record (the model runs it when done); slice S7b
#   defer <rid> [<until>] [--reason <w>]  append a defer event; the watcher reschedules the record; slice S7b
#
# Later slices add status, run, cancel and the rest. Hooks only APPEND; the watcher owns every
# state transition. Bash 3.2 safe, jq is the only non-coreutils dependency.

# No set -e on purpose: the record path must be fail-open.

_br_self="${BASH_SOURCE[0]:-$0}"
while [ -L "$_br_self" ]; do
    _br_link="$(readlink "$_br_self" 2>/dev/null)" || break
    case "$_br_link" in
        /*) _br_self="$_br_link" ;;
        *) _br_self="${_br_self%/*}/$_br_link" ;;
    esac
done
_br_bindir="${_br_self%/*}"
[ "$_br_bindir" = "$_br_self" ] && _br_bindir="."
BORG_RESUME_LIBDIR="${BORG_RESUME_LIBDIR:-$_br_bindir/../lib/borg}"

_BR_EVENTS="session_start dispatch_intent dispatch_bound agent_start agent_stop stop_failure session_end"
_BR_EVENTS="$_BR_EVENTS idle_prompt permission_prompt native_resume"

_br_known_event() {
    case " $_BR_EVENTS " in
        *" $1 "*) return 0 ;;
    esac
    return 1
}

# BORG_IN_CONTAINER=0 forces host mode and 1 forces container mode; when unset, /.dockerenv decides.
_br_in_container() {
    case "${BORG_IN_CONTAINER:-}" in
        0) return 1 ;;
        1) return 0 ;;
    esac
    [ -f "${BORG_DOCKERENV_FILE:-/.dockerenv}" ] || [ -f /run/.containerenv ]
}

# True when pid $1 is $2 or a descendant of it (bounded walk up the parent chain).
_br_pid_under() {
    local _p="$1" _top="$2" _i=0
    while [ -n "$_p" ] && [ "$_p" -gt 1 ] 2>/dev/null && [ "$_i" -lt 64 ]; do
        [ "$_p" = "$_top" ] && return 0
        _p="$(ps -o ppid= -p "$_p" 2>/dev/null)"
        _p="${_p//[[:space:]]/}"
        _i=$((_i + 1))
    done
    return 1
}

# True when pid $1 is a non-interactive claude (-p / --print): it must never bind or own a pane.
_br_headless() {
    local _cmd
    _cmd="$(ps -o command= -p "$1" 2>/dev/null)"
    case " $_cmd " in
        *" -p "* | *" --print "* | *" --print="*) return 0 ;;
    esac
    return 1
}

# Build the event line: ONE compact JSON object, or nothing when the payload is unusable (no string session_id, or
# an id outside the filename-safe charset, checked here so a TAB or newline can never smuggle in a second field).
# Every field tolerates absence. A stop_failure is always scope main (U1: its agent_id is unverified). Every string
# field is capped at 256 chars, except msg at 600, so a line stays well under the 4KB that O_APPEND writes are
# atomic for.
_br_build_event() {
    local _ev="$1" _t="$2"
    jq -c --arg ev "$_ev" --argjson t "$_t" '
        def s: if type == "string" then . else null end;
        def c: if . == null then null else .[0:256] end;
        (.session_id | s) as $sid
        | select($sid != null and ($sid | test("^[A-Za-z0-9_-]{1,128}\\z")))
        | (.agent_id | s | c | if . != null and test("^\\s*\\z") then null else . end) as $aid_raw
        | (if $ev == "stop_failure" then null else $aid_raw end) as $aid
        | {
            t: $t,
            ev: $ev,
            sid: $sid,
            scope: (if $aid != null then "agent:" + $aid else "main" end),
            agent_id: $aid,
            error: (.error | s | c),
            msg: ((.last_assistant_message // .message // .msg | s) | if . == null then null else .[0:600] end),
            tool_use_id: (.tool_use_id | s | c),
            run_id: ((.run_id // .tool_response.runId // .tool_input.resumeFromRunId) | s | c),
            script_path: ((.script_path // .tool_input.scriptPath) | s | c),
            agent_type: ((.agent_type // .tool_input.subagent_type) | s | c),
            reason: ((.reason // .source) | s | c)
          }
        | with_entries(select(.value != null or (.key | IN("agent_id", "error", "msg", "tool_use_id"))))
    ' 2>/dev/null
}

# Collect tmux pane facts into _br_p_* variables. Only ever called for a host session with $TMUX_PANE set.
# Binds the pane to the session with a pane option so the watcher can find it after pane ids are renumbered.
_br_pane_facts() {
    local _sid="$1" _cpid="$2" _out _sep
    _br_p_id="" _br_p_pid="" _br_p_session="" _br_p_window="" _br_p_widx="" _br_p_pidx="" _br_p_dir=""
    command -v tmux >/dev/null 2>&1 || return 1
    [ -n "${TMUX_PANE:-}" ] && [ -n "${TMUX:-}" ] || return 1
    _br_headless "$_cpid" && return 1
    _sep=$'\t'
    _out="$(tmux display -p -t "$TMUX_PANE" \
        "#{pane_id}${_sep}#{pane_pid}${_sep}#{session_name}${_sep}#{window_name}${_sep}#{window_index}${_sep}"\
"#{pane_index}${_sep}#{@project_dir}" \
        2>/dev/null)" || return 1
    [ -n "$_out" ] || return 1
    IFS=$'\t' read -r _br_p_id _br_p_pid _br_p_session _br_p_window _br_p_widx _br_p_pidx _br_p_dir <<EOF
$_out
EOF
    if ! _br_pid_under "$_cpid" "$_br_p_pid"; then
        _br_p_id="" _br_p_pid="" _br_p_session="" _br_p_window="" _br_p_widx="" _br_p_pidx="" _br_p_dir=""
        return 1
    fi
    tmux set-option -p -t "$TMUX_PANE" @borg_sid "$_sid" >/dev/null 2>&1
    return 0
}

# The SessionStart-only registry write. Immutable facts, tmp + mv, replaced atomically by a later session_start
# for the same sid. No other handler ever calls this.
_br_write_registry() {
    local _sid="$1" _payload="$2" _reg _cwd _src _in_c _mode _proj _cpid _cstart
    _cwd="$(printf '%s' "$_payload" | jq -r '.cwd // empty' 2>/dev/null)"
    _src="$(printf '%s' "$_payload" | jq -r '.source // empty' 2>/dev/null)"
    _in_c=false
    _br_in_container && _in_c=true
    _proj="${_cwd%/}"
    _proj="${_proj##*/}"
    _mode=""
    if [ -n "$_cwd" ]; then
        _mode="$( . "$BORG_RESUME_LIBDIR/../borg-hooks.sh" >/dev/null 2>&1 && _borg_session_mode "$_cwd" 2>/dev/null)"
    fi

    _cpid="" _cstart=""
    _br_p_id="" _br_p_pid="" _br_p_session="" _br_p_window="" _br_p_widx="" _br_p_pidx="" _br_p_dir=""
    if [ "$_in_c" = false ]; then
        # The hook forwards its own parent (claude); a bare $PPID here would be the short-lived hook shell.
        case "${BORG_RESUME_CLAUDE_PID:-}" in
            "" | *[!0-9]*) _cpid="$PPID" ;;
            *) _cpid="$BORG_RESUME_CLAUDE_PID" ;;
        esac
        _cstart="$(LC_ALL=C ps -o lstart= -p "$_cpid" 2>/dev/null)"
        _cstart="${_cstart#"${_cstart%%[![:space:]]*}"}"
        _cstart="${_cstart%"${_cstart##*[![:space:]]}"}"
        _br_pane_facts "$_sid" "$_cpid"
    fi

    _reg="$(jq -n --arg sid "$_sid" --arg source "$_src" --arg cwd "$_cwd" --arg project "$_proj" --arg mode "$_mode" \
        --argjson in_c "$_in_c" --arg cpid "$_cpid" --arg cstart "$_cstart" \
        --arg pid_ "$_br_p_id" --arg ppid_ "$_br_p_pid" --arg sess "$_br_p_session" --arg win "$_br_p_window" \
        --arg widx "$_br_p_widx" --arg pidx "$_br_p_pidx" --arg pdir "$_br_p_dir" '
        def n: (try tonumber catch null);
        def e: if . == "" then null else . end;
        {
            session_id: $sid,
            source: ($source | e),
            cwd: ($cwd | e),
            project: ($project | e),
            mode: ($mode | e),
            in_container: $in_c,
            claude_pid: ($cpid | n),
            claude_start: ($cstart | e),
            tmux: (if $pid_ == "" then null else {
                pane_id: $pid_, pane_pid: ($ppid_ | n), session: ($sess | e), window: ($win | e),
                window_index: ($widx | n), pane_index: ($pidx | n), project_dir: ($pdir | e)
            } end)
        }' 2>/dev/null)"
    [ -n "$_reg" ] || return 0
    printf '%s\n' "$_reg" | borg_resume_write_atomic "$(borg_resume_registry_file "$_sid")"
}

# Detection step 1: a stop_failure line is classified at record time so the fact already carries class, action and
# resume_at (S2 resume_plan, attempt 0; the watcher recomputes with the real attempt count and stays the authority).
# Fail-open: any trouble returns the line unchanged. Costs one jq plus the classifier, no network.
_br_classify_line() {
    local _l="$1" _jf _err _msg _plan _class _action _ra _out
    # shellcheck source=/dev/null
    . "$BORG_RESUME_LIBDIR/resume-classify.sh" 2>/dev/null || { printf '%s' "$_l"; return 0; }
    _jf='[(.error // "unknown"), ((.msg // "") | gsub("[\\n\\r]"; " "))] | join("\u001f")'
    IFS=$'\x1f' read -r _err _msg <<EOF
$(printf '%s' "$_l" | jq -r "$_jf" 2>/dev/null)
EOF
    _plan="$(resume_plan "${_err:-unknown}" "$_msg" 0 2>/dev/null)"
    _class="${_plan%% *}"
    _plan="${_plan#* }"
    _action="${_plan%% *}"
    _ra="${_plan#* }"
    case "$_class$_action" in "" | *[!a-z_]*) printf '%s' "$_l"; return 0 ;; esac
    _out="${_l%\}},\"class\":\"$_class\",\"action\":\"$_action\""
    case "$_ra" in "" | *[!0-9]*) ;; *) _out="$_out,\"resume_at\":$_ra" ;; esac
    printf '%s}' "$_out"
}

_br_record() {
    local _ev="${1:-}" _payload _t _built _sid _line
    _br_known_event "$_ev" || return 0
    borg_resume_disabled_env && return 0
    borg_resume_no_session_hooks && return 0
    command -v jq >/dev/null 2>&1 || return 0
    _payload="$(cat 2>/dev/null)"
    [ -n "$_payload" ] || return 0
    case "${BORG_RESUME_NOW_EPOCH:-}" in
        "" | *[!0-9]*) _t="$(date +%s)" ;;
        *) _t="$BORG_RESUME_NOW_EPOCH" ;;
    esac
    _built="$(printf '%s' "$_payload" | _br_build_event "$_ev" "$_t")"
    [ -n "$_built" ] || return 0
    _line="$_built"
    [ "$_ev" = "stop_failure" ] && _line="$(_br_classify_line "$_line")"
    # sid is the third key of the compact line and already passed the charset check in the builder: no second jq.
    _sid="${_line#*\"sid\":\"}"
    _sid="${_sid%%\"*}"
    borg_resume_valid_sid "$_sid" || return 0
    borg_resume_append_line "$(borg_resume_events_file "$_sid")" "$_line"
    if [ "$_ev" = "session_start" ]; then
        _br_write_registry "$_sid" "$_payload"
    fi
    return 0
}

_br_usage() {
    printf 'usage: borg-resume <record <event> | pause | unpause | probe | inventory <sid> [--json]' >&2
    printf ' | watch --once | prompt <rid> [--line|--compact-line|--stdout] | mark-closed <project|sid> [dir]' >&2
    printf ' | ack <rid> | defer <rid> [<until>] [--reason <word>]>\n' >&2
}

_br_main() {
    local _cmd="${1:-}"
    [ $# -gt 0 ] && shift
    if [ "$_cmd" = "record" ]; then
        # S12: a missing lib is a real install fault, not a swallowed event: exit 3 with one stderr line so the
        # hook can log it. Every failure AFTER the lib loads stays fail-open.
        # shellcheck source=/dev/null
        if ! . "$BORG_RESUME_LIBDIR/resume-paths.sh" 2>/dev/null; then
            printf "borg-resume: cannot load %s/resume-paths.sh (lib not installed?)\n" "$BORG_RESUME_LIBDIR" >&2
            return 3
        fi
        { _br_record "$@"; } 2>/dev/null
        return 0
    fi
    # shellcheck source=/dev/null
    . "$BORG_RESUME_LIBDIR/resume-paths.sh" 2>/dev/null || {
        printf 'borg-resume: cannot load %s/resume-paths.sh\n' "$BORG_RESUME_LIBDIR" >&2
        return 1
    }
    case "$_cmd" in
        pause)
            mkdir -p "$(borg_resume_dir)" && : >"$(borg_resume_sentinel)" || return 1
            printf 'borg-resume paused: no resume will be injected (recording continues)\n'
            ;;
        unpause)
            rm -f "$(borg_resume_sentinel)" || return 1
            printf 'borg-resume unpaused\n'
            ;;
        probe)
            # shellcheck source=/dev/null
            . "$BORG_RESUME_LIBDIR/resume-probe.sh" 2>/dev/null || return 1
            borg_resume_probe
            ;;
        inventory)
            local _isid="" _ia
            for _ia in "$@"; do
                case "$_ia" in
                    --json) ;;
                    -*) _br_usage; return 2 ;;
                    *) [ -z "$_isid" ] && _isid="$_ia" ;;
                esac
            done
            if [ $# -eq 0 ] || { [ -z "$_isid" ] && [ "$*" = "--json" ]; }; then
                _br_usage
                return 2
            fi
            # shellcheck source=/dev/null
            . "$BORG_RESUME_LIBDIR/resume-classify.sh" && . "$BORG_RESUME_LIBDIR/resume-inventory.sh" || return 1
            command -v jq >/dev/null 2>&1 || { printf 'borg-resume: jq is required\n' >&2; return 1; }
            borg_resume_inventory "$_isid"
            ;;
        watch)
            [ "${1:-}" = "--once" ] && [ $# -eq 1 ] || { _br_usage; return 2; }
            # shellcheck source=/dev/null
            . "$BORG_RESUME_LIBDIR/resume-classify.sh" && . "$BORG_RESUME_LIBDIR/resume-inventory.sh" &&
                . "$BORG_RESUME_LIBDIR/resume-watch.sh" && . "$BORG_RESUME_LIBDIR/resume-prompt.sh" &&
                . "$BORG_RESUME_LIBDIR/resume-gate.sh" || return 1
            borg_resume_watch_once
            ;;
        prompt)
            # shellcheck source=/dev/null
            . "$BORG_RESUME_LIBDIR/resume-classify.sh" && . "$BORG_RESUME_LIBDIR/resume-inventory.sh" \
                && . "$BORG_RESUME_LIBDIR/resume-prompt.sh" || return 1
            command -v jq >/dev/null 2>&1 || { printf 'borg-resume: jq is required\n' >&2; return 1; }
            borg_resume_prompt "$@"
            local _prc=$?
            [ "$_prc" -eq 2 ] && _br_usage
            return "$_prc"
            ;;
        mark-closed)
            [ -n "${1:-}" ] || { _br_usage; return 2; }
            # shellcheck source=/dev/null
            . "$BORG_RESUME_LIBDIR/resume-close.sh" 2>/dev/null || return 1
            borg_resume_mark_closed "$1" "${2:-}"
            ;;
        ack | defer)
            # shellcheck source=/dev/null
            . "$BORG_RESUME_LIBDIR/resume-verbs.sh" 2>/dev/null || return 1
            "borg_resume_$_cmd" "$@"
            local _vrc=$?
            [ "$_vrc" -eq 2 ] && _br_usage
            return "$_vrc"
            ;;
        *)
            _br_usage
            return 2
            ;;
    esac
}

_br_main "$@"
exit $?
