#!/usr/bin/env zsh
# borg-notifyd — host daemon: fires macOS notifications when any repository transitions to waiting
# Managed by launchd as the `notifyd` agent (label via lib/launchd-label.zsh). Not for direct
# invocation.

set -euo pipefail

# $HOME/.local/bin holds `claude` (native installer). launchd hands jobs a minimal PATH that omits
# it, so leaving it out makes this daemon exit 127 on every fire while `launchctl list` shows it
# registered. See tests/agent_path.bats — every launchd-run script must keep this prefix.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

REGISTRY="${BORG_REGISTRY:-$HOME/.config/borg/registry.json}"
LOG_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/borg"
LOG="$LOG_DIR/notifyd.log"

log() { echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $*" >> "$LOG" }

mkdir -p "$LOG_DIR"

typeset -A last_status

fire() {
    local repository="$1" window="$2"
    local subtitle="${window:+$window — }$repository"
    log "notify $repository (window=${window:-none})"
    _borg_osa_notify "Claude Code" "$subtitle" "Ready for input"
}

check() {
    local silent="${1:-}"  # pass any non-empty string to record state without firing
    local lines
    # Fields are joined with the ASCII unit separator (\u001f), NOT a tab. A tab is IFS whitespace, so
    # `read` collapses adjacent tabs and an empty tmux_window shifts notify_origin into `window`.
    # A non-whitespace IFS character keeps empty fields. Order: repository, status, window, origin.
    lines=$(jq -r '.repositories // {} | to_entries[] | "\(.key)\u001f\(.value.status // "idle")\u001f\(.value.tmux_window // "")\u001f\(.value.notify_origin // "")"' \
        "$REGISTRY" 2>/dev/null) || return 0
    local -A seen
    while IFS=$'\x1f' read -r repository repo_status window origin; do
        seen[$repository]=1
        local prev="${last_status[$repository]:-}"
        last_status[$repository]="$repo_status"
        # Only fire for container-origin transitions — host-origin is already handled by notify.sh
        [[ -z "$silent" && "$repo_status" == "waiting" && "$prev" != "waiting" && "$origin" == "container" ]] && fire "$repository" "$window"
    done <<< "$lines"
    for key in "${(@k)last_status}"; do
        [[ -z "${seen[$key]:-}" ]] && unset "last_status[$key]"
    done
}

# Test seam: tests/notifyd.bats sources this file with BORG_NOTIFYD_LIB_ONLY=1 to get log/fire/check
# without the dependency probes, the registry requirement or the fswatch loop below.
[[ -n "${BORG_NOTIFYD_LIB_ONLY:-}" ]] && return 0

for dep in fswatch jq osascript; do
    command -v "$dep" &>/dev/null || { log "ERROR: $dep not found in PATH"; exit 1 }
done

[[ -f "$HOME/.claude/lib/borg-hooks.sh" ]] || { log "ERROR: lib/borg-hooks.sh not found (run borg setup)"; exit 1 }
source "$HOME/.claude/lib/borg-hooks.sh"

[[ -f "$REGISTRY" ]] || { log "ERROR: registry not found: $REGISTRY"; exit 1 }

log "started. watching $REGISTRY"

# Silent initial snapshot — record current state without firing to avoid startup floods
check silent

fswatch -o "$REGISTRY" | while read -r; do
    check
done
