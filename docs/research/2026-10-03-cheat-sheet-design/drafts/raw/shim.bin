document.addEventListener("DOMContentLoaded", function () {

    const domainsToDecorate = [
        'app.shimmer.care',
        'shimmercare.typeform.com',
        'shimmer.care/assessment',
        'buy.stripe.com'
    ];

    const inferredCampaignPages = {
        '/blog/': 'blog'
    };

    const trackingParams = [
        'utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content',
        'referral', 'via', 'code'
    ];

    function parseInitialParams() {
        const urlParams = new URLSearchParams(window.location.search);
        let storedParams = localStorage.getItem('shimmer_tracking_parameters');
        storedParams = storedParams ? JSON.parse(storedParams) : {};

        // One-time cleanup: purge a poisoned `code` left in storage by the old
        // via-to-code fallback. Only fires when the current URL has `via` and no
        // `code`, which is the exact signature of the old bug. A legit `?code=`
        // visit is never affected because it always carries `code` in the URL.
        // Temporary — safe to remove once the poisoned population has cycled through.
        if (urlParams.has('via') && !urlParams.has('code') && storedParams['code']) {
            delete storedParams['code'];
            localStorage.setItem('shimmer_tracking_parameters', JSON.stringify(storedParams));
        }

        let params = {};
        trackingParams.forEach(param => {
            if (urlParams.has(param)) {
                params[param] = urlParams.get(param);
            } else if (storedParams[param]) {
                params[param] = storedParams[param];
            }
        });

        // Set default utm_source
        if (!params['utm_source']) {
            params['utm_source'] = 'direct/no attribution';
        }

        // Set default utm_content
        if (!params['utm_content']) {
            const slug = window.location.pathname;
            params['utm_content'] = slug === '/' ? 'homepage' : slug.substring(1);
        }

        // Infer utm_campaign from path
        if (!params['utm_campaign']) {
            for (const path in inferredCampaignPages) {
                if (window.location.pathname.startsWith(path)) {
                    params['utm_campaign'] = inferredCampaignPages[path];
                }
            }
        }

        // Map affiliate `via` to utm_source so the affiliate value rides through to
        // Stripe and lands in Airtable as an independent tracking breadcrumb.
        // Rewardful still handles real attribution via client_reference_id on the page.
        if (params['via']) {
            params['utm_source'] = params['via'];
        }

        return params;
    }

    function decorateLinks(paramsObj) {
        const params = new URLSearchParams(paramsObj);
        const links = document.querySelectorAll('a[href]');
        links.forEach(link => {
            try {
                const linkHref = new URL(link.href, window.location.origin);
                const normalizedHostname = linkHref.hostname.toLowerCase();
                if (domainsToDecorate.some(domain => normalizedHostname.includes(domain)) || link.hasAttribute('data-utm-track')) {
                    params.forEach((value, key) => {
                        linkHref.searchParams.set(key, value);
                        if (key === 'code' && value) linkHref.searchParams.set('prefilled_promo_code', value);
                    });
                    link.href = linkHref.toString();
                }
            } catch (e) {
                console.error('Invalid URL encountered: ', link.href);
            }
        });
    }

    function addTrackingFieldsToForms(params) {
        const forms = document.querySelectorAll('form[data-utm-track]');
        forms.forEach(form => {
            Object.entries(params).forEach(([key, value]) => {
                const hiddenInput = document.createElement('input');
                hiddenInput.type = 'hidden';
                hiddenInput.name = key;
                hiddenInput.value = value;
                form.appendChild(hiddenInput);
            });
        });
    }

    function addDebugInfoToFooter(params) {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('debug') === 'true') {
            const debugDiv = document.createElement('div');
            debugDiv.style.border = '1px solid red';
            debugDiv.style.padding = '10px';
            debugDiv.style.marginTop = '10px';
            debugDiv.textContent = `Tracking Parameters Debug Info: ${JSON.stringify(params)}`;
            const footerTarget = document.querySelector('div.footer-3 > div > div > div > div.padding-top.padding-medium');
            if (footerTarget) {
                footerTarget.appendChild(debugDiv);
            }
        }
    }

    function applyTracking(params) {
        localStorage.setItem('shimmer_tracking_parameters', JSON.stringify(params));
        decorateLinks(params);
        addTrackingFieldsToForms(params);
        addDebugInfoToFooter(params);
    }

    const params = parseInitialParams();
    applyTracking(params);


    // Only run on /membership or /summit
    const path = window.location.pathname;
    if (path.startsWith("/membership") || path.startsWith("/summit")) {

      // Now fetch referral code if needed (only if code wasn't manually set)
      const urlParams = new URLSearchParams(window.location.search);
      const manualCode = urlParams.has('code');
      const referral = params['referral'];

      if (!manualCode && referral) {
          fetch("https://us-central1-shimmer-production.cloudfunctions.net/getCommunityReferralCode", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ referral })
          })
          .then(res => res.json())
          .then(data => {
              if (data.code) {
                  params['code'] = data.code;
                  params['utm_term'] = referral; //track referral id in checkout
                  localStorage.setItem('shimmer_tracking_parameters', JSON.stringify(params));
                  decorateLinks(params);
                  addTrackingFieldsToForms(params);
              }
          })
          .catch(err => {
              console.warn("Error fetching referral code:", err);
          });
      }

    }

});
</script>



<script>
// Shimmer Text effect using the class .em-shimmer
(function() {
  function emShimmerRandom(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  function emShimmerCreateSparkle(color) {
    const size = emShimmerRandom(10, 20);
    const sparkle = document.createElement('span');
    sparkle.classList.add('em-shimmer-sparkle');
    sparkle.innerHTML = `
      <svg width="${size}" height="${size}" viewBox="0 0 68 68" fill="${color}">
        <path d="M26.5 25.5C19.0043 33.3697 0 34 0 34C0 34 19.1013 35.3684 26.5 43.5C33.234 50.901 34 68 34 68C34 68 36.9884 50.7065 44.5 43.5C51.6431 36.647 68 34 68 34C68 34 51.6947 32.0939 44.5 25.5C36.5605 18.2235 34 0 34 0C34 0 33.6591 17.9837 26.5 25.5Z" />
      </svg>
    `;
    sparkle.style.top = `calc(${emShimmerRandom(0, 100)}% - ${size / 2}px - 1rem)`;
    sparkle.style.left = `calc(${emShimmerRandom(0, 100)}% - ${size / 2}px)`;
    return sparkle;
  }

  function emShimmerAddSparkle(element, color) {
    const sparkle = emShimmerCreateSparkle(color);
    element.appendChild(sparkle);
    setTimeout(() => {
      sparkle.remove();
    }, 1500);
  }

  document.querySelectorAll('.em-shimmer').forEach(el => {
    const sparkleInterval = setInterval(() => {
      if (document.contains(el)) {
        emShimmerAddSparkle(el, '#FFC700');
      } else {
        clearInterval(sparkleInterval);
      }
    }, emShimmerRandom(600, 1200));
  });
})();
</script>
<script>
// when the DOM is ready
$(document).ready(function() {
  // get the li items
  const listItems = $('li');
  // for each li item
  listItems.each(function(index, item){
    // check for '~' character
    // it's recommended to start with the deepest level of sub bullet
    // to ensure only the relevant classes are applied
    
    // if the li item text starts with '~~'
    if($(item).text().startsWith('~~')){
      // run indentText() function
      indentText(this, 'hack20-sub-bullet-2');
    }	// else if the li item starts with '~'
    else if($(item).text().startsWith('~')){
      // run indentText() function
      indentText(this, 'hack20-sub-bullet');
    }	
  });
 
  // indentText function
  function indentText(li, className){
    // add relevant className to li item
    // if the li item text starts with '~~' add the sub-bullet-2 class
    // else if the li item starts with '~' add the sub-bullet class
    $(li).addClass(className);
    // remove the '~' from the li items
    // the regex /~+/g 
    // matches any one or more ~ characters
    const reformatedText = $(li).html().replace(/~+/g,'');
    // replace the li item's html text that has ~ tags
    // with the new text that removed the ~ character(s)
    $(li).html(reformatedText);
  }
});
</script></body></html>