186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path></svg></a></div></div><div class="grid grid-cols-2 gap-x-8 gap-y-8 sm:grid-cols-3 lg:grid-cols-4"><div><h3 class="text-xs font-bold uppercase tracking-wider text-white mb-3">Education &amp; Training</h3><ul class="space-y-2"><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/education-training/article-book-reviews/">Article &amp; Book Reviews</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/education-training/early-career-psychologists-training-education/">Early Career Psychologists</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/education-training/podcasts/">Podcasts</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/education-training/student-development/">Student Development</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/education-training/supervision-training/">Supervision &amp; Training</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/education-training/teaching/">Teaching</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/education-training/videos/">Videos</a></li></ul></div><div><h3 class="text-xs font-bold uppercase tracking-wider text-white mb-3">Practice &amp; Research</h3><ul class="space-y-2"><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/practice-research/assessment-treatment/">Assessment &amp; Treatment</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/practice-research/bridging-practice-research/">Bridging Practice &amp; Research</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/practice-research/ethics-legal/">Ethics &amp; Legal</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/practice-research/diversity/">Diversity</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/practice-research/psychotherapy-process/">Psychotherapy Process</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/practice-research/self-care-development/">Self-Care &amp; Development</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/practice-research/termination/">Termination</a></li></ul></div><div><h3 class="text-xs font-bold uppercase tracking-wider text-white mb-3">Social Justice</h3><ul class="space-y-2"><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/social-justice-public-policy/advocacy/">Advocacy</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/social-justice-public-policy/public-policy/">Public Policy</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/social-justice-public-policy/social-justice/">Social Justice</a></li></ul></div><div><h3 class="text-xs font-bold uppercase tracking-wider text-white mb-3">News</h3><ul class="space-y-2"><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/news-announcements/society-news/">Society News</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/news-announcements/conference-announcements/">Conference Announcements</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/news-announcements/past-presidential-columns/">Past Presidential Columns</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/news-announcements/presidents-column/">President&#x27;s Column</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/category/news-announcements/psychotherapy-electronic-communications-editors-column/">Editor&#x27;s Column</a></li></ul></div><div><h3 class="text-xs font-bold uppercase tracking-wider text-white mb-3">Members</h3><ul class="space-y-2"><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/members/awards-and-grants/">Awards &amp; Grants</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/members/fellows/">Fellows</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/members/member-portal/">Member Resources</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/members/student-portal/">Student Portal</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/members/sustaining-members/">Sustaining Members</a></li></ul></div><div><h3 class="text-xs font-bold uppercase tracking-wider text-white mb-3">Domains</h3><ul class="space-y-2"><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/domains/diversity/">Diversity</a></li><li><a class="text-[13px] leading-tight text-white/75 hover:text-white transition-colors" href="/domains/early-career/">Early Career</a></li><li><a class="text-[13px] leading-tight text-white/75 hover: