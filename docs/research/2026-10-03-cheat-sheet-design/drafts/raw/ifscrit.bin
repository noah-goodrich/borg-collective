<!DOCTYPE html><html data-dpl-id="dpl_2qwofzrAg457HzXVuV36RC4i1VAL" lang="en"><head><meta charSet="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="preload" as="image" href="https://societyforpsychotherapy.org/wp-content/uploads/2024/08/site-logo-350x100-3.png"/><link rel="preload" href="https://cms.societyforpsychotherapy.org/wp-content/uploads/2024/06/Lisa-Brownstone-96x96.jpg" as="image"/><link rel="preload" href="https://cms.societyforpsychotherapy.org/wp-content/uploads/2024/06/Madison-Hunsicker-96x96.jpg" as="image"/><link rel="preload" href="https://cms.societyforpsychotherapy.org/wp-content/uploads/2024/06/Amanda-Greene-96x96.jpg" as="image"/><link rel="preload" href="https://cms.societyforpsychotherapy.org/wp-content/uploads/2024/06/iStock-1053519140.jpg" as="image"/><link rel="preload" as="image" href="https://secure.gravatar.com/avatar/909c049552e883f63073e1f327b44be231412374070799fcf9b23c963823dbe9?s=48&amp;d=mm&amp;r=g"/><link rel="preload" as="image" href="https://secure.gravatar.com/avatar/ceb6ca41ff942bd8c4bd4aa292273bf85788a1088b3ff5cc92e978910493967a?s=48&amp;d=mm&amp;r=g"/><link rel="preload" as="image" href="https://secure.gravatar.com/avatar/b2838ecb5a9daae41495c7a14b0de62ba3baf0570fc613795a1e517461528c2b?s=48&amp;d=mm&amp;r=g"/><link rel="preload" as="image" href="https://secure.gravatar.com/avatar/cd6c7ee148beec79f28a1c523b66ab7bebcfacbb387ba71a902f3cfa6f39e49f?s=48&amp;d=mm&amp;r=g"/><link rel="preload" as="image" href="https://secure.gravatar.com/avatar/e0255083319def33b1d75ea0d0924d7adb65bd302ee776e3a3aa173d01a8abfb?s=48&amp;d=mm&amp;r=g"/><link rel="stylesheet" href="/_next/static/chunks/04ogv8dzqvzg2.css?dpl=dpl_2qwofzrAg457HzXVuV36RC4i1VAL" data-precedence="next"/><link rel="preload" as="script" fetchPriority="low" href="/_next/static/chunks/0zaia6i55l01..js?dpl=dpl_2qwofzrAg457HzXVuV36RC4i1VAL"/><script src="/_next/static/chunks/0pqt~8bl3ukh4.js?dpl=dpl_2qwofzrAg457HzXVuV36RC4i1VAL" async=""></script><script src="/_next/static/chunks/0m_p1bxtorv5i.js?dpl=dpl_2qwofzrAg457HzXVuV36RC4i1VAL" async=""></script><script src="/_next/static/chunks/01.9z.p3zi3ol.js?dpl=dpl_2qwofzrAg457HzXVuV36RC4i1VAL" async=""></script><script src="/_next/static/chunks/turbopack-14f.mg7fokd94.js?dpl=dpl_2qwofzrAg457HzXVuV36RC4i1VAL" async=""></script><script src="/_next/static/chunks/0zuy8ea9xv6-m.js?dpl=dpl_2qwofzrAg457HzXVuV36RC4i1VAL" async=""></script><script src="/_next/static/chunks/0d3shmwh5_nmn.js?dpl=dpl_2qwofzrAg457HzXVuV36RC4i1VAL" async=""></script><script src="/_next/static/chunks/00ta6t3128ajv.js?dpl=dpl_2qwofzrAg457HzXVuV36RC4i1VAL" async=""></script><script src="/_next/static/chunks/0c8hm7lcis1l-.js?dpl=dpl_2qwofzrAg457HzXVuV36RC4i1VAL" async=""></script><script src="/_next/static/chunks/17z2p6eu-gn9_.js?dpl=dpl_2qwofzrAg457HzXVuV36RC4i1VAL" async=""></script><link rel="preload" href="https://analytics.ahrefs.com/analytics.js" as="script"/><link rel="preload" as="image" href="https://secure.gravatar.com/avatar/c2a35ce22f65239770d54a8284d4d18e154ff59cfd52edcd2a5f91fdc3b091c5?s=48&amp;d=mm&amp;r=g"/><link rel="preload" as="image" href="https://secure.gravatar.com/avatar/c36e049349f834396a4c2aa333bf235f5c5e0c91ad2d41277d53486672927eee?s=48&amp;d=mm&amp;r=g"/><link rel="preload" as="image" href="https://secure.gravatar.com/avatar/ab60e638db950615e9c749aee96fd5612e77b8be53c1422e59557286e0985c6f?s=48&amp;d=mm&amp;r=g"/><link rel="preload" as="image" href="https://secure.gravatar.com/avatar/0f60b7cc2fcd29b3545ca889d8d87e506f45ccca4f46359697a7fe6f45b1ae45?s=48&amp;d=mm&amp;r=g"/><link rel="preload" as="image" href="https://secure.gravatar.com/avatar/2c1b8a648cc541d84f082483fc61c73af41cddc23bb6097bc44416c328ced534?s=48&amp;d=mm&amp;r=g"/><link rel="preload" as="image" href="https://secure.gravatar.com/avatar/f774267d7dc5eac9ca02b56e1d900eb055c6b9da4764e955c1c54c1fca3d7455?s=48&amp;d=mm&amp;r=g"/><link rel="preload" as="image" href="https://secure.gravatar.com/avatar/9cbca925b3d