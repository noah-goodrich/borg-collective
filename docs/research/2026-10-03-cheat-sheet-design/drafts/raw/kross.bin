<div class="d-panels font-secondary-light">
<div id="aip_a" class="d-panel p" style="display: none">
<div class="p" id="Aff1">
<sup>1</sup>Department of Psychology, Michigan State University, East Lansing, Michigan USA </div>
<div id="Aff2">
<sup>2</sup>Department of Psychology, University of Michigan, Ann Arbor, Michigan USA </div>
