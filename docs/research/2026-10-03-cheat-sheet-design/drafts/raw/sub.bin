.amazonaws.com%2Fpublic%2Fimages%2Fa9cbff3a-43d8-4f21-aab3-ac716ccc4e9c_1024x1536.png 1272w, https://substackcdn.com/image/fetch/$s_!4xok!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fa9cbff3a-43d8-4f21-aab3-ac716ccc4e9c_1024x1536.png 1456w\\\" sizes=\\\"100vw\\\" loading=\\\"lazy\\\"></picture><div class=\\\"image-link-expand\\\"><div class=\\\"pencraft pc-display-flex pc-gap-8 pc-reset\\\"><button tabindex=\\\"0\\\" type=\\\"button\\\" class=\\\"pencraft pc-reset pencraft icon-container restack-image buttonBase-GK1x3M\\\"><svg aria-hidden=\\\"true\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 20 20\\\" fill=\\\"none\\\" stroke-width=\\\"1.5\\\" stroke=\\\"var(--color-fg-primary)\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\" class=\\\"icon-noB79L\\\"><g><path d=\\\"M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882\\\"></path></g></svg></button><button tabindex=\\\"0\\\" type=\\\"button\\\" class=\\\"pencraft pc-reset pencraft icon-container view-image buttonBase-GK1x3M\\\"><svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" class=\\\"lucide lucide-maximize2 lucide-maximize-2 icon-noB79L\\\"><polyline points=\\\"15 3 21 3 21 9\\\"></polyline><polyline points=\\\"9 21 3 21 3 15\\\"></polyline><line x1=\\\"21\\\" x2=\\\"14\\\" y1=\\\"3\\\" y2=\\\"10\\\"></line><line x1=\\\"3\\\" x2=\\\"10\\\" y1=\\\"21\\\" y2=\\\"14\\\"></line></svg></button></div></div></div></a></figure></div>\",\"has_dynamic_content\":false,\"truncated_body_text\":\"AuDHD (autism + ADHD) can feel like living with two operating systems at once: one craves pattern, predictability, and sensory truth; the other craves novelty, urgency, and dopamine. When you add alexithymia (trouble identifying/putting words to feelings) and\",\"wordcount\":4018,\"post_preview_limit\":null,\"language\":\"en\",\"postTags\":[{\"id\":\"39180ca0-81b0-42f5-bbbe-dadd39e1c04d\",\"publication_id\":4456750,\"name\":\"AuDHD\",\"slug\":\"audhd\",\"hidden\":false},{\"id\":\"3a7e9433-b216-4b6e-aca1-cbc341579e82\",\"publication_id\":4456750,\"name\":\"audhd-alexithymia-anhedonia\",\"slug\":\"audhd-alexithymia-anhedonia\",\"hidden\":false},{\"id\":\"42587d4d-6c40-418c-a307-e3727cc1857a\",\"publication_id\":4456750,\"name\":\"living with AuDHD\",\"slug\":\"living-with-audhd\",\"hidden\":false},{\"id\":\"75d6fc07-969b-49f7-804f-5a22352210ed\",\"publication_id\":4456750,\"name\":\"emotional awarenes\",\"slug\":\"emotional-awarenes\",\"hidden\":false},{\"id\":\"80be1628-46f1-4268-8587-e7642e6dabe9\",\"publication_id\":4456750,\"name\":\"anhedonia\",\"slug\":\"anhedonia\",\"hidden\":false},{\"id\":\"cabf3dab-29ce-4bbc-8054-563b4564198b\",\"publication_id\":4456750,\"name\":\"kids and adults\",\"slug\":\"kids-and-adults\",\"hidden\":false},{\"id\":\"ce00c8ce-6512-479d-b03b-33f226fc6764\",\"publication_id\":4456750,\"name\":\"alexithymia\",\"slug\":\"alexithymia\",\"hidden\":false}],\"postCountryBlocks\":[],\"headlineTest\":null,\"coverImagePalette\":{\"Vibrant\":{\"rgb\":[245,108,148],\"population\":21},\"DarkVibrant\":{\"rgb\":[47,14,138],\"population\":209},\"LightVibrant\":{\"rgb\":[249,132,151],\"population\":466},\"Muted\":{\"rgb\":[171,95,155],\"population\":74},\"DarkMuted\":{\"rgb\":[76,58,88],\"population\":431},\"LightMuted\":{\"rgb\":[175,146,202],\"population\":214}},\"publishedBylines\":[{\"id\":109463432,\"name\":\"carmen_authenticallyadhd\",\"handle\":\"